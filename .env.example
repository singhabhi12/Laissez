# Copy to .env.local and fill in. None of these are needed to run the app
# locally; only "Report a problem" depends on the GitHub ones.

# Absolute origin, used for canonical URLs, Open Graph image URLs and the
# sitemap. No trailing slash. Falls back to https://laissez.example.
NEXT_PUBLIC_SITE_URL=https://laissez.example

# --- Report a problem -------------------------------------------------------
# A fine-grained personal access token with "Issues: read and write" on the
# repository below, and nothing else. Server-side only: it is never exposed to
# the browser. Without it, POST /api/report returns 503 and the form shows an
# error rather than failing silently.
GITHUB_TOKEN=

# Only for GitHub Enterprise; defaults to https://api.github.com
# GITHUB_API_URL=

# owner/repo that receives the reports. Issues are labelled "data-report".
#
# NOTE: reports are filed as issues in this repository. If it is public, every
# report — including any email address a reporter chooses to give — is public
# too. Use a private repository unless you want that.
GITHUB_REPO=your-org/your-repo
